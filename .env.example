OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Required in production — consumers send X-API-Key or Authorization: Bearer
NEUGATE_API_KEY=change-me-in-production

NEUGATE_CONFIG_DIR=config/projects
NEUGATE_SCHEMA_PATH=config/schema/neugate-schema.json
NEUGATE_LLM_TIMEOUT_SECONDS=8
NEUGATE_LLM_MAX_TOKENS=128

NEUGATE_TEST_RUNNER_MAX_CASES=100
NEUGATE_TEST_RUNNER_CONCURRENCY=10

NEUGATE_HOST=0.0.0.0
NEUGATE_PORT=8080
NEUGATE_LOG_LEVEL=info

# Phase-1 agentic semantic gate (local FAISS; run scripts/seed_vector_db.py first)
NEUGATE_AGENTIC_ENABLED=true
NEUGATE_AGENTIC_INDEX_PATH=config/agentic/neugate_agentic.index
NEUGATE_AGENTIC_META_PATH=config/agentic/neugate_agentic.meta.json
NEUGATE_AGENTIC_THRESHOLD=0.82
NEUGATE_AGENTIC_MODEL=paraphrase-multilingual-MiniLM-L12-v2
